      "texts": [
       {
        "chapo": {
         "text": "Superlative. More than a word, it is a vision. A commitment."
        }
       },
       {
        "paragraph": {
         "text": "A commitment to designing and manufacturing increasingly reliable, high-performance watches. Inscribed on every dial, this word reflects our founding values."
        }
       },
       {
        "paragraph": {
         "text": "This vision of watchmaking is founded upon seven pillars that shape our identity: precision, waterproofness, self-winding mechanism, autonomy, resistance to magnetism, reliability, and sustainability.\n\n"
        }
       },
       {
        "paragraph": {
         "text": "Seven pillars that inspire us to exceed standards and push boundaries. Seven pillars that serve every wearer, wherever their journey takes them. Seven pillars, mastered in their entirety, that make Rolex unique in the watchmaking world.\n\n"
        }
       }
      ],
      "theme": {
       "theme": "light-theme"
      },
      "title": "watchmaking:hub:intro-article-simple"
     }
    ]
   }
